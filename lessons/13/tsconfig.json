{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "strict": true, "noEmit": true, "skipLibCheck": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
